<!-- ============================================================
     高级门店预约页 · 黄金教学样例（MUSE 美学空间 · 高级造型沙龙）
     学习重点：
       · 门店 HeroBanner + 评分 / 距离 / 营业状态信息层级
       · 服务项目 / 造型师 / 日期 / 时段四级可点选预约流程
       · 备注 textarea 与手机号 input 双向绑定
       · 底部 fake tabBar 切换 activeTab（首页/服务/案例/我的）
       · 确认预约按钮带校验并 wx.showToast
     注意：图标全部用 CSS 绘制，不使用 emoji；派生文案在 JS 算好再绑定。
     ============================================================ -->
<view class="page">

  <view class="navbar {{scrolled ? 'navbar-solid' : ''}}">
    <view class="nav-back" bindtap="onBack" hover-class="op-press"><view class="ic-back"></view></view>
    <text class="nav-title">{{nav.title}}</text>
    <view class="nav-share" bindtap="onShare" hover-class="op-press"><view class="ic-share"></view></view>
  </view>

  <!-- ================= 首页 Tab ================= -->
  <view class="pane" wx:if="{{activeTab === 'home'}}">

    <!-- ① HeroBanner 门店主视觉 -->
    <view class="hero">
      <swiper class="hero-swiper" autoplay="true" interval="4500" circular="true" current="{{heroCurrent}}" bindchange="onHeroChange">
        <swiper-item wx:for="{{heroImages}}" wx:key="id">
          <image class="hero-img" src="{{item.src}}" mode="aspectFill" bindtap="onPreviewStore" data-id="{{item.id}}"></image>
        </swiper-item>
      </swiper>
      <view class="hero-mask"></view>
      <view class="hero-body">
        <view class="hero-status"><text class="hero-status-text">{{store.statusText}}</text></view>
        <text class="hero-name">{{store.name}}</text>
        <text class="hero-tagline">{{store.tagline}}</text>
      </view>
    </view>

    <!-- ② 门店概要 -->
    <view class="block store-meta">
      <view class="meta-item" bindtap="onReviewsTab" hover-class="op-dim">
        <text class="meta-num">{{store.rating}}</text>
        <text class="meta-label">评分</text>
      </view>
      <view class="meta-divider"></view>
      <view class="meta-item">
        <text class="meta-num">¥{{store.avgPrice}}</text>
        <text class="meta-label">人均</text>
      </view>
      <view class="meta-divider"></view>
      <view class="meta-item" bindtap="onNavigate" hover-class="op-dim">
        <text class="meta-num">{{store.distance}}</text>
        <text class="meta-label">距你</text>
      </view>
      <view class="meta-divider"></view>
      <view class="meta-item" bindtap="onHours" hover-class="op-dim">
        <text class="meta-num">{{store.hoursShort}}</text>
        <text class="meta-label">营业</text>
      </view>
    </view>

    <!-- 地址条 -->
    <view class="block addr-bar" bindtap="onNavigate" hover-class="op-dim">
      <view class="ic-pin"></view>
      <text class="addr-text">{{store.address}}</text>
      <view class="addr-go"><text class="addr-go-text">导航</text><view class="ic-chevron sm"></view></view>
    </view>

    <!-- ③ 选择服务项目 -->
    <view class="block">
      <view class="block-head">
        <text class="block-title">选择服务</text>
        <text class="block-extra">{{selectedServiceName}}</text>
      </view>
      <view class="srv {{selectedService === item.id ? 'srv-on' : ''}}" wx:for="{{servicesPick}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectService" hover-class="card-press">
        <image class="srv-img" src="{{item.src}}" mode="aspectFill"></image>
        <view class="srv-body">
          <view class="srv-top">
            <text class="srv-name">{{item.name}}</text>
            <view class="srv-hot" wx:if="{{item.hot}}"><text class="srv-hot-text">热门</text></view>
          </view>
          <text class="srv-desc">{{item.desc}}</text>
          <view class="srv-foot">
            <view class="srv-dur"><view class="ic-clock"></view><text class="srv-dur-text">{{item.duration}}</text></view>
            <text class="srv-price">¥{{item.price}}</text>
          </view>
        </view>
        <view class="srv-check"></view>
      </view>
    </view>

    <!-- ④ 选择造型师 -->
    <view class="block">
      <view class="block-head">
        <text class="block-title">选择造型师</text>
        <text class="block-extra">{{selectedStylistName}}</text>
      </view>
      <scroll-view class="sty-scroll" scroll-x="true">
        <view class="sty-row">
          <view class="sty {{selectedStylist === item.id ? 'sty-on' : ''}}" wx:for="{{stylists}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectStylist" hover-class="card-press">
            <image class="sty-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
            <text class="sty-name">{{item.name}}</text>
            <text class="sty-title">{{item.title}}</text>
            <view class="sty-rate">
              <view class="star star-on"></view>
              <text class="sty-rate-text">{{item.rating}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ⑤ 选择日期 -->
    <view class="block">
      <view class="block-head"><text class="block-title">选择日期</text></view>
      <scroll-view class="date-scroll" scroll-x="true">
        <view class="date-row">
          <view class="date {{selectedDate === item.id ? 'date-on' : ''}}" wx:for="{{dates}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectDate" hover-class="op-press">
            <text class="date-week">{{item.week}}</text>
            <text class="date-day">{{item.day}}</text>
            <view class="date-dot" wx:if="{{item.few}}"></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ⑥ 选择时段 -->
    <view class="block">
      <view class="block-head">
        <text class="block-title">选择时段</text>
        <text class="block-extra">{{selectedSlotName}}</text>
      </view>
      <view class="slot-grid">
        <view class="slot {{item.full ? 'slot-full' : ''}} {{selectedSlot === item.id ? 'slot-on' : ''}}" wx:for="{{slots}}" wx:key="id" data-id="{{item.id}}" data-full="{{item.full}}" bindtap="onSelectSlot" hover-class="card-press">
          <text class="slot-time">{{item.time}}</text>
          <text class="slot-state">{{item.full ? '约满' : item.tip}}</text>
        </view>
      </view>
    </view>

    <!-- ⑦ 联系信息（互动②：input / textarea 双向绑定） -->
    <view class="block form-block">
      <view class="block-head"><text class="block-title">联系信息</text></view>
      <view class="field">
        <text class="field-label">手机号<text class="req">*</text></text>
        <input class="field-input" type="number" maxlength="11" placeholder="到店提醒将发送至此" placeholder-class="ph" value="{{form.phone}}" bindinput="onPhoneInput" />
      </view>
      <view class="field field-col">
        <text class="field-label">备注</text>
        <textarea class="field-area" placeholder="发量 / 期望风格 / 过敏史等，越详细越好（{{noteLen}}/60）" placeholder-class="ph" maxlength="60" value="{{form.note}}" bindinput="onNoteInput"></textarea>
      </view>
    </view>

    <!-- ⑧ 门店环境 -->
    <view class="block">
      <view class="block-head">
        <text class="block-title">门店环境</text>
        <text class="block-extra" bindtap="onAllPhotos" hover-class="op-dim">{{galleryCount}} 张</text>
      </view>
      <scroll-view class="env-scroll" scroll-x="true">
        <view class="env-row">
          <view class="env-wrap" wx:for="{{environment}}" wx:key="*this" data-src="{{item}}" bindtap="onPreviewEnv" hover-class="op-dim">
            <image class="env-img" src="{{item}}" mode="aspectFill"></image>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ⑨ 用户评价 -->
    <view class="block">
      <view class="block-head">
        <text class="block-title">到店评价</text>
        <text class="block-extra" bindtap="onReviewsTab" hover-class="op-dim">查看全部</text>
      </view>
      <view class="review" wx:for="{{reviews}}" wx:key="id" data-id="{{item.id}}" bindtap="onReview" hover-class="op-dim">
        <view class="review-head">
          <image class="review-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="review-user">
            <text class="review-name">{{item.name}}</text>
            <text class="review-meta">{{item.service}} · {{item.stylist}}</text>
          </view>
          <view class="review-stars">
            <view class="star {{st.on ? 'star-on' : ''}}" wx:for="{{item.stars}}" wx:for-item="st" wx:key="i"></view>
          </view>
        </view>
        <text class="review-text">{{item.text}}</text>
        <view class="review-imgs" wx:if="{{item.hasImg}}">
          <view class="review-img-wrap" wx:for="{{item.imgs}}" wx:for-item="ri" wx:key="*this">
            <image class="review-img" src="{{ri}}" mode="aspectFill"></image>
          </view>
        </view>
      </view>
    </view>

    <view class="end-note"><text class="end-note-text">— 期待为你服务 —</text></view>
  </view>

  <!-- ================= 服务 Tab ================= -->
  <view class="pane" wx:if="{{activeTab === 'service'}}">
    <view class="pane-hd">
      <text class="pane-hd-title">全部服务</text>
      <text class="pane-hd-sub">价格透明，明码标价</text>
    </view>

    <view class="block" wx:for="{{serviceGroups}}" wx:key="id" wx:for-item="grp">
      <view class="grp-title"><text class="grp-title-text">{{grp.title}}</text></view>
      <view class="price-row" wx:for="{{grp.items}}" wx:for-item="it" wx:key="id" data-name="{{it.name}}" bindtap="onPriceItem" hover-class="op-dim">
        <view class="price-info">
          <text class="price-name">{{it.name}}</text>
          <text class="price-desc">{{it.desc}}</text>
        </view>
        <view class="price-right">
          <text class="price-num">¥{{it.price}}</text>
          <text class="price-dur">{{it.duration}}</text>
        </view>
      </view>
    </view>

    <view class="block card-promo">
      <view class="block-head"><text class="block-title">会员储值卡</text></view>
      <view class="vipcard {{selectedCard === item.id ? 'vipcard-on' : ''}}" wx:for="{{vipCards}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectCard" hover-class="card-press">
        <view class="vipcard-left">
          <text class="vipcard-name">{{item.name}}</text>
          <text class="vipcard-desc">{{item.desc}}</text>
        </view>
        <view class="vipcard-right">
          <text class="vipcard-price">¥{{item.price}}</text>
          <text class="vipcard-value">含 ¥{{item.value}}</text>
        </view>
      </view>
      <button class="card-btn" bindtap="onBuyCard" hover-class="btn-press">立即开卡</button>
    </view>
  </view>

  <!-- ================= 案例 Tab ================= -->
  <view class="pane" wx:if="{{activeTab === 'cases'}}">
    <view class="pane-hd">
      <text class="pane-hd-title">造型作品集</text>
      <text class="pane-hd-sub">每一次改变，都被认真对待</text>
    </view>

    <view class="block">
      <view class="seg">
        <view class="seg-item {{worksTab === item.key ? 'seg-on' : ''}}" wx:for="{{worksTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onWorksTab" hover-class="op-press">
          <text class="seg-text">{{item.label}}</text>
        </view>
      </view>

      <view wx:if="{{worksTab === 'hair'}}">
        <view class="works-grid">
          <view class="work" wx:for="{{worksHair}}" wx:key="id" data-id="{{item.id}}" bindtap="onWork" hover-class="card-press">
            <image class="work-img" src="{{item.src}}" mode="aspectFill"></image>
            <view class="work-meta">
              <text class="work-title">{{item.title}}</text>
              <text class="work-by">by {{item.by}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{worksTab === 'color'}}">
        <view class="works-grid">
          <view class="work" wx:for="{{worksColor}}" wx:key="id" data-id="{{item.id}}" bindtap="onWork" hover-class="card-press">
            <image class="work-img" src="{{item.src}}" mode="aspectFill"></image>
            <view class="work-meta">
              <text class="work-title">{{item.title}}</text>
              <text class="work-by">by {{item.by}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ================= 我的 Tab ================= -->
  <view class="pane" wx:if="{{activeTab === 'mine'}}">
    <view class="mine-hero">
      <view class="mine-top">
        <image class="mine-avatar" src="{{me.avatar}}" mode="aspectFill"></image>
        <view class="mine-id">
          <text class="mine-name">{{me.name}}</text>
          <text class="mine-tag">{{me.tag}}</text>
        </view>
        <view class="mine-set" bindtap="onSettings" hover-class="op-press"><view class="ic-gear"></view></view>
      </view>
      <view class="mine-balance">
        <view class="bal-item" bindtap="onBalance" hover-class="op-dim">
          <text class="bal-num">¥{{me.balance}}</text>
          <text class="bal-label">卡内余额</text>
        </view>
        <view class="bal-item" bindtap="onCoupons" hover-class="op-dim">
          <text class="bal-num">{{me.coupons}}</text>
          <text class="bal-label">优惠券</text>
        </view>
        <view class="bal-item" bindtap="onPoints" hover-class="op-dim">
          <text class="bal-num">{{me.points}}</text>
          <text class="bal-label">积分</text>
        </view>
      </view>
    </view>

    <view class="block booking-card" bindtap="onMyBooking" hover-class="op-dim">
      <view class="bk-tag"><text class="bk-tag-text">即将到店</text></view>
      <text class="bk-service">{{me.next.service}}</text>
      <view class="bk-info">
        <view class="bk-info-item"><view class="ic-clock"></view><text class="bk-info-text">{{me.next.time}}</text></view>
        <view class="bk-info-item"><view class="ic-pin"></view><text class="bk-info-text">{{me.next.stylist}}</text></view>
      </view>
      <view class="bk-actions">
        <view class="bk-btn bk-btn-ghost" catchtap="onReschedule" hover-class="op-press"><text class="bk-btn-text">改约</text></view>
        <view class="bk-btn bk-btn-fill" catchtap="onCheckin" hover-class="op-press"><text class="bk-btn-text-fill">到店核销</text></view>
      </view>
    </view>

    <view class="block">
      <view class="menu-row" wx:for="{{menus}}" wx:key="label" data-label="{{item.label}}" bindtap="onMenu" hover-class="op-dim">
        <view class="menu-ic ic-{{item.icon}}"></view>
        <text class="menu-label">{{item.label}}</text>
        <text class="menu-extra">{{item.extra}}</text>
        <view class="ic-chevron"></view>
      </view>
    </view>
  </view>

  <!-- ③ 底部预约条（首页显示，互动③：button → wx.showToast） -->
  <view class="actionbar" wx:if="{{activeTab === 'home'}}">
    <view class="ab-left" bindtap="onConsult" hover-class="op-dim">
      <view class="ic-service"></view>
      <text class="ab-left-text">咨询</text>
    </view>
    <view class="ab-summary">
      <text class="ab-summary-label">已选</text>
      <text class="ab-summary-text">{{summary}}</text>
    </view>
    <button class="ab-btn" bindtap="onConfirm" hover-class="btn-press">确认预约</button>
  </view>

  <!-- ④ 底部 fake tabBar -->
  <view class="tabbar">
    <view class="tabbar-item {{activeTab === item.key ? 'tab-active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-tab="{{item.key}}" bindtap="switchTab" hover-class="op-press">
      <view class="nav-ic nav-ic-{{item.icon}}"></view>
      <text class="tabbar-label">{{item.label}}</text>
    </view>
  </view>

</view>
