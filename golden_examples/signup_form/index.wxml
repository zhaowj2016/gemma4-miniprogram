<view class="container">
  <view class="hero">
    <text class="hero-title">{{title}}</text>
    <text class="hero-sub">名额有限, 先到先得</text>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入姓名" value="{{formData.name}}" bindinput="onNameInput" />
      <text class="error" wx:if="{{errors.name}}">{{errors.name}}</text>
    </view>

    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入 11 位手机号" value="{{formData.phone}}" bindinput="onPhoneInput" />
      <text class="error" wx:if="{{errors.phone}}">{{errors.phone}}</text>
    </view>
  </view>

  <view class="footer">
    <button class="submit-btn" bindtap="onSubmit">立即报名</button>
  </view>
</view>
