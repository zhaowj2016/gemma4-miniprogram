.container {
  padding-bottom: 160rpx; /* 给固定底栏留出空间, 避免遮挡内容 */
}

/* 轮播图 */
.banner {
  width: 100%;
  height: 560rpx;
}
.banner-slide {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 36rpx;
  background: linear-gradient(135deg, #6a8dff, #9b7bff);
}

/* 商品信息 */
.info {
  padding: 30rpx 24rpx;
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}
.price {
  font-size: 52rpx;
  color: #e31d1a;
  font-weight: 700;
  margin-right: 16rpx;
}
.price-original {
  font-size: 28rpx;
  color: #999999;
  text-decoration: line-through;
}

/* 标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}
.tag {
  background-color: #eef3ff;
  color: #3a6df0;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 18rpx;
  margin-right: 14rpx;
  margin-bottom: 12rpx;
}

/* 描述 */
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.desc {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: #555555;
}

/* 底部吸边操作栏 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}
.buy-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #e31d1a;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 44rpx;
}
