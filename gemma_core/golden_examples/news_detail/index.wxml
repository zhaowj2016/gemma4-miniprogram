<view class="container">
  <view class="article">
    <text class="article-tag">{{tagText}}</text>
    <text class="article-title">{{title}}</text>
    <view class="article-meta">
      <text class="meta-source">{{sourceText}}</text>
      <text class="meta-time">{{timeText}}</text>
      <text class="meta-views">{{viewCountText}} 阅读</text>
    </view>

    <view class="article-content">
      <text class="content-paragraph" wx:for="{{paragraphs}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="quote-block">
      <text class="quote-text">"{{quoteText}}"</text>
    </view>

    <view class="article-content">
      <text class="content-paragraph">{{closingText}}</text>
    </view>

    <view class="action-row">
      <view class="action-btn" bindtap="onLikeTap">
        <text class="action-btn-text {{isLiked ? 'action-btn-text-active' : ''}}">{{likeBtnText}}</text>
      </view>
      <view class="action-btn" bindtap="onFavTap">
        <text class="action-btn-text {{isFavorited ? 'action-btn-text-active' : ''}}">{{favBtnText}}</text>
      </view>
      <view class="action-btn" bindtap="onShareTap">
        <text class="action-btn-text">分享</text>
      </view>
    </view>
  </view>

  <view class="related">
    <text class="related-title">相关推荐</text>
    <view class="related-list">
      <view class="related-item" wx:for="{{related}}" wx:key="id" bindtap="onRelatedTap" data-id="{{item.id}}">
        <text class="related-item-title">{{item.title}}</text>
        <view class="related-item-meta">
          <text class="related-meta-time">{{item.timeText}}</text>
          <text class="related-meta-views">{{item.viewCountText}} 阅读</text>
        </view>
      </view>
    </view>
  </view>

  <view class="comment-section">
    <view class="comment-header">
      <text class="comment-title">评论 ({{commentCountText}})</text>
    </view>
    <view class="comment-list">
      <view class="comment-item" wx:for="{{comments}}" wx:key="id">
        <view class="comment-avatar">
          <text class="comment-avatar-text">{{item.avatarText}}</text>
        </view>
        <view class="comment-body">
          <text class="comment-name">{{item.name}}</text>
          <text class="comment-text">{{item.text}}</text>
          <text class="comment-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer">
    <input class="footer-input" placeholder="说点什么..." value="{{draftText}}" bindinput="onDraftInput" />
    <view class="footer-send" bindtap="onSendTap">
      <text class="footer-send-text">发送</text>
    </view>
  </view>
</view>
