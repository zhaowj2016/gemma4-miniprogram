.container {
  padding-bottom: 140rpx;
  background-color: #ffffff;
}

/* 文章区 */
.article {
  padding: 40rpx 32rpx;
  border-bottom: 16rpx solid #f7f8fa;
}
.article-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #ffffff;
  background-color: #3a6df0;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  margin-bottom: 24rpx;
}
.article-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 24rpx;
}
.article-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 40rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.meta-source {
  margin-right: 20rpx;
}
.meta-time {
  margin-right: 20rpx;
}
.article-content {
  margin-bottom: 32rpx;
}
.content-paragraph {
  display: block;
  font-size: 30rpx;
  color: #333333;
  line-height: 1.9;
  margin-bottom: 24rpx;
}

/* 引用 */
.quote-block {
  margin: 32rpx 0;
  padding: 24rpx 28rpx;
  background-color: #f7f8fa;
  border-left: 6rpx solid #3a6df0;
  border-radius: 0 12rpx 12rpx 0;
}
.quote-text {
  display: block;
  font-size: 28rpx;
  color: #555555;
  line-height: 1.7;
  font-style: italic;
}

/* 文章操作 */
.action-row {
  display: flex;
  padding-top: 16rpx;
}
.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background-color: #f7f8fa;
  border-radius: 36rpx;
  margin-right: 16rpx;
}
.action-btn:last-child {
  margin-right: 0;
}
.action-btn-text {
  font-size: 26rpx;
  color: #555555;
}
.action-btn-text-active {
  color: #e31d1a;
  font-weight: 600;
}

/* 相关推荐 */
.related {
  padding: 32rpx;
  border-bottom: 16rpx solid #f7f8fa;
}
.related-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}
.related-list {
  display: flex;
  flex-direction: column;
}
.related-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.related-item:last-child {
  border-bottom: none;
}
.related-item-title {
  display: block;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.5;
  margin-bottom: 10rpx;
}
.related-item-meta {
  display: flex;
  font-size: 22rpx;
  color: #aaaaaa;
}
.related-meta-time {
  margin-right: 20rpx;
}

/* 评论区 */
.comment-section {
  padding: 32rpx;
}
.comment-header {
  margin-bottom: 24rpx;
}
.comment-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.comment-list {
  display: flex;
  flex-direction: column;
}
.comment-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.comment-item:last-child {
  border-bottom: none;
}
.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6a8dff, #9b7bff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.comment-avatar-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.comment-body {
  flex: 1;
}
.comment-name {
  display: block;
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
  margin-bottom: 6rpx;
}
.comment-text {
  display: block;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
.comment-time {
  display: block;
  font-size: 22rpx;
  color: #aaaaaa;
}

/* 底部输入栏 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}
.footer-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: #f5f6f8;
  border-radius: 36rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.footer-send {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background-color: #3a6df0;
  border-radius: 36rpx;
}
.footer-send-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}
