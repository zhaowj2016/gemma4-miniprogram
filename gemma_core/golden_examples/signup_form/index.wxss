.container {
  padding-bottom: 160rpx;
}

/* 头图区 */
.hero {
  padding: 56rpx 32rpx;
  background: linear-gradient(135deg, #3a6df0, #6a8dff);
  color: #ffffff;
}
.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.hero-sub {
  display: block;
  font-size: 26rpx;
  opacity: 0.85;
}

/* 表单 */
.form {
  padding: 24rpx;
}
.field {
  margin-bottom: 32rpx;
}
.label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.error {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #e31d1a;
}

/* 底部吸边按钮 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #3a6df0;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 44rpx;
}
