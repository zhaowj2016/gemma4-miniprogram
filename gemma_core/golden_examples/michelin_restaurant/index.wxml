<view class="page-container">
  <!-- 顶部状态栏 & 品牌区 -->
  <view class="brand-header">
    <text class="brand-name">L'ÉLITE GASTRONOMIE</text>
    <text class="brand-subtitle">米其林三星 · 极致味觉艺术</text>
  </view>

  <!-- 高端轮播图 (参考图片中的高对比度与极简构图) -->
  <swiper class="main-swiper" current="{{currentBannerIndex}}" bindchange="onSwiperChange" indicator-dots="true" autoplay="true" interval="4000">
    <swiper-item wx:for="{{banners}}" wx:key="url">
      <view class="swiper-item-wrapper">
        <image src="{{item.url}}" mode="aspectFill" class="swiper-image" />
        <view class="swiper-overlay">
          <text class="swiper-title">{{item.title}}</text>
          <text class="swiper-desc">{{item.desc}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 实时场景播报区 (模拟真实应用场景) -->
  <view class="broadcast-bar">
    <view class="broadcast-tag">NEWS</view>
    <scroll-view class="broadcast-content" scroll-x="true">
      <text class="broadcast-text">{{broadcasts[currentBroadcastIndex]}}</text>
    </scroll-view>
  </view>

  <!-- 菜单交互区 -->
  <view class="menu-section">
    <view class="tab-nav">
      <view class="tab-item {{activeTab === 'tasting' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="tasting">
        <text>主厨精选</text>
        <view class="tab-line"></view>
      </view>
      <view class="tab-item {{activeTab === 'alacarte' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="alacarte">
        <text>单点菜单</text>
        <view class="tab-line"></view>
      </view>
    </view>

    <scroll-view scroll-y="true" class="menu-list">
      <block wx:for="{{menu[activeTab]}}" wx:key="id">
        <view class="menu-card">
          <view class="card-image-box">
            <image src="{{item.image}}" mode="aspectFill" class="card-image" />
            <view class="tag-container">
              <text class="item-tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
            </view>
          </view>
          <view class="card-info">
            <view class="info-top">
              <text class="item-name">{{item.name}}</text>
              <text class="item-price">¥{{item.price}}</text>
            </view>
            <text class="item-desc">{{item.desc}}</text>
            
            <view class="card-action">
              <view class="qty-control">
                <view class="qty-btn minus" bindtap="onMinus" data-id="{{item.id}}">
                  <text>-</text>
                </view>
                <text class="qty-value">{{item.qty}}</text>
                <view class="qty-btn plus" bindtap="onPlus" data-id="{{item.id}}">
                  <text>+</text>
                </view>
              </view>
              <button class="add-btn" bindtap="onPlus" data-id="{{item.id}}" wx:if="{{item.qty === 0}}">
                加入预订
              </button>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- 底部固定操作栏 -->
  <view class="footer-bar">
    <view class="cart-summary">
      <view class="cart-icon-box">
        <text class="cart-icon">🍽️</text>
        <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
      </view>
      <view class="price-detail">
        <text class="price-label">预计总额</text>
        <text class="price-total">¥{{totalPrice}}</text>
      </view>
    </view>
    <button class="checkout-btn" bindtap="onCheckout">
      确认预约席位
    </button>
  </view>
</view>