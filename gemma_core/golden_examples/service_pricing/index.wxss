.container {
  padding-bottom: 60rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.header {
  padding: 48rpx 32rpx 24rpx;
  text-align: center;
}
.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}
.header-sub {
  display: block;
  font-size: 26rpx;
  color: #777777;
}

/* 计费切换 */
.toggle-row {
  display: flex;
  justify-content: center;
  margin: 16rpx 32rpx 24rpx;
  background-color: #eef0f4;
  border-radius: 40rpx;
  padding: 6rpx;
}
.toggle {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #555555;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.toggle-active {
  background-color: #ffffff;
  color: #3a6df0;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.toggle-text {
  font-size: 26rpx;
}
.toggle-tag {
  font-size: 20rpx;
  color: #ff7a59;
  margin-left: 8rpx;
  background-color: #fff1eb;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

/* 套餐卡 */
.plan-list {
  padding: 0 24rpx;
}
.plan-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  border: 2rpx solid #ffffff;
  box-sizing: border-box;
}
.plan-card-featured {
  border-color: #3a6df0;
  background: linear-gradient(180deg, #f0f5ff 0%, #ffffff 60%);
}
.plan-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background-color: #3a6df0;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.plan-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.plan-desc {
  display: block;
  font-size: 24rpx;
  color: #777777;
  margin-bottom: 20rpx;
}
.plan-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 6rpx;
}
.plan-currency {
  font-size: 28rpx;
  color: #1a1a1a;
  margin-right: 4rpx;
}
.plan-price {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1;
}
.plan-cycle {
  font-size: 24rpx;
  color: #777777;
  margin-left: 4rpx;
}
.plan-original {
  display: block;
  font-size: 22rpx;
  color: #999999;
  text-decoration: line-through;
  margin-bottom: 24rpx;
}
.plan-feature-list {
  display: flex;
  flex-direction: column;
  margin: 16rpx 0 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.plan-feature-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.plan-feature-bullet {
  color: #19be6b;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 12rpx;
  line-height: 1.6;
}
.plan-feature-text {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
  flex: 1;
}
.plan-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
}
.plan-btn-ghost {
  background-color: #f5f6f8;
}
.plan-btn-primary {
  background-color: #3a6df0;
}
.plan-btn-text {
  font-size: 28rpx;
  font-weight: 500;
}
.plan-btn-ghost .plan-btn-text {
  color: #1a1a1a;
}
.plan-btn-primary .plan-btn-text {
  color: #ffffff;
}

/* FAQ */
.faq-section {
  margin: 32rpx 24rpx 0;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}
.faq-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}
.faq-list {
  display: flex;
  flex-direction: column;
}
.faq-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.faq-item:last-child {
  border-bottom: none;
}
.faq-q {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.faq-a {
  display: block;
  font-size: 24rpx;
  color: #777777;
  line-height: 1.7;
}
