/* 基础变量与全局样式 */
.page-container {
  background-color: #FDFBFA;
  min-height: 100vh;
  padding-bottom: 160rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* 店铺头部 */
.shop-header {
  padding: 48rpx 32rpx 24rpx;
  background-color: #ffffff;
}
.shop-name {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  color: #2C1810;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}
.shop-slogan {
  display: block;
  font-size: 26rpx;
  color: #8B5E3C;
  margin-bottom: 24rpx;
  font-weight: 500;
}
.shop-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.meta-item {
  font-size: 22rpx;
  color: #A1887F;
  background-color: #F5F0ED;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

/* Banner 轮播 */
.main-banner {
  width: 100%;
  height: 360rpx;
  margin: 0 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(44, 24, 16, 0.12);
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-img {
  width: 100%;
  height: 100%;
}
.banner-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 60%;
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
}
.banner-content {
  position: absolute;
  bottom: 40rpx;
  left: 32rpx;
  color: #ffffff;
}
.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.banner-sub {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 分类筛选 */
.category-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 32rpx 0;
}
.category-wrapper {
  display: inline-flex;
  padding: 0 32rpx;
  gap: 24rpx;
}
.category-item {
  padding: 16rpx 32rpx;
  background-color: #ffffff;
  border: 2rpx solid #E8DCD5;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #6D4C41;
  transition: all 0.3s ease;
}
.category-active {
  background-color: #8B5E3C;
  color: #ffffff;
  border-color: #8B5E3C;
  box-shadow: 0 4rpx 12rpx rgba(139, 94, 60, 0.3);
}

/* 商品区域 */
.product-section {
  padding: 0 32rpx;
}
.section-title {
  display: flex;
  align-items: center;
  margin: 40rpx 0 32rpx;
}
.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C1810;
  margin-right: 24rpx;
}
.title-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(to right, #D7B9A1, transparent);
}

.product-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.product-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease;
}
.product-card:active {
  transform: scale(0.98);
}

.card-image-box {
  position: relative;
  width: 100%;
  height: 220rpx;
}
.product-img {
  width: 100%;
  height: 100%;
}
.product-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: #C6A664;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.card-body {
  padding: 24rpx;
}
.card-main-info {
  margin-bottom: 24rpx;
}
.product-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2C1810;
  margin-bottom: 8rpx;
}
.product-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.product-price {
  font-size: 34rpx;
  font-weight: 900;
  color: #8B5E3C;
}

/* 数量选择器 */
.qty-control {
  display: flex;
  align-items: center;
  background-color: #F5F0ED;
  border-radius: 12rpx;
  padding: 4rpx;
}
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}
.qty-btn text {
  font-size: 32rpx;
  font-weight: 700;
  color: #8B5E3C;
}
.qty-num {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #2C1810;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 140rpx;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid #EEE;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  z-index: 100;
}
.bar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.cart-badge {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  background-color: #F5F0ED;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-count {
  font-size: 32rpx;
  font-weight: 900;
  color: #8B5E3C;
}
.price-info {
  display: flex;
  flex-direction: column;
}
.price-label {
  font-size: 22rpx;
  color: #A1887F;
}
.total-price {
  font-size: 36rpx;
  font-weight: 900;
  color: #2C1810;
}

.submit-btn {
  height: 88rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, #8B5E3C, #6D4C41);
  color: #ffffff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(139, 94, 60, 0.3);
  border: none;
}
.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.96);
}