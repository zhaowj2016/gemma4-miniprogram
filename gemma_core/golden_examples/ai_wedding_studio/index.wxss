/* 全局背景与容器 */
.page-container {
  background-color: #0a0a0a;
  color: #ffffff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* 顶部导航 */
.header-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60rpx 32rpx 30rpx;
  z-index: 10;
}
.user-info {
  display: flex;
  flex-direction: column;
}
.user-name {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(to right, #d4af37, #f9e29c);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 10rpx;
}
.user-badges {
  display: flex;
  gap: 12rpx;
}
.badge {
  font-size: 22rpx;
  background: rgba(212, 175, 55, 0.2);
  color: #d4af37;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
}
.cart-icon {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-text {
  font-size: 32rpx;
}
.cart-count {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #ff4d4f;
  color: white;
  font-size: 20rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #0a0a0a;
}

/* 轮播图 */
.main-swiper {
  height: 500rpx;
  width: 100%;
}
.swiper-image {
  width: 100%;
  height: 100%;
}
.swiper-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.8));
}
.swiper-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.swiper-desc {
  font-size: 26rpx;
  opacity: 0.8;
  color: #ccc;
}

/* Tab 切换 */
.tab-container {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 0;
  background: #0a0a0a;
}
.tab-item {
  position: relative;
  padding: 10rpx 0;
  font-size: 30rpx;
  color: #888;
  transition: all 0.3s;
}
.tab-item.tab-active {
  color: #d4af37;
  font-weight: 600;
}
.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 4rpx;
  background: #d4af37;
  transition: width 0.3s ease;
}
.tab-active .tab-line {
  width: 40rpx;
}

/* 内容区通用 */
.content-scroll {
  flex: 1;
}
.section-header {
  padding: 40rpx 32rpx;
}
.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.section-subtitle {
  font-size: 24rpx;
  color: #666;
}

/* 作品集网格 */
.gallery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 32rpx;
}
.gallery-card {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: #1a1a1a;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.5);
}
.gallery-img {
  width: 100%;
  height: 300rpx;
  display: block;
}
.gallery-info {
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.img-title {
  font-size: 26rpx;
  color: #ddd;
}
.like-btn {
  font-size: 32rpx;
  transition: transform 0.2s;
}
.like-btn:active {
  transform: scale(1.3);
}
.like-btn.liked {
  color: #ff4d4f;
}

/* AI 服务列表 */
.services-list {
  padding: 0 32rpx;
}
.service-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background 0.3s;
}
.service-card:active {
  background: rgba(255, 255, 255, 0.1);
}
.service-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.service-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #1a1a1a, #333);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}
.service-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.service-detail {
  font-size: 24rpx;
  color: #888;
  line-height: 1.4;
}
.service-right {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.service-tag {
  font-size: 20rpx;
  color: #d4af37;
  background: rgba(212, 175, 55, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}
.service-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

/* 预约套餐 */
.package-container {
  padding: 0 32rpx;
}
.package-card {
  background: #151515;
  border: 1rpx solid #222;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  position: relative;
  transition: all 0.3s;
}
.pkg-highlight {
  border: 2rpx solid #d4af37;
  background: linear-gradient(145deg, #1a1a1a, #0a0a0a);
  box-shadow: 0 20rpx 40rpx rgba(212, 175, 55, 0.1);
}
.pkg-badge {
  position: absolute;
  top: -20rpx;
  right: 40rpx;
  background: #d4af37;
  color: #000;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.pkg-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.pkg-price-box {
  display: flex;
  align-items: baseline;
  margin-bottom: 30rpx;
}
.currency {
  font-size: 32rpx;
  color: #d4af37;
  margin-right: 4rpx;
}
.amount {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
}
.unit {
  font-size: 24rpx;
  color: #666;
  margin-left: 10rpx;
}
.pkg-features {
  margin-bottom: 40rpx;
}
.feat-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 16rpx;
}
.feat-dot {
  color: #d4af37;
  margin-right: 12rpx;
  font-weight: bold;
}
.pkg-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #d4af37;
  color: #000;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}
.pkg-highlight .pkg-btn {
  background: linear-gradient(to right, #d4af37, #f9e29c);
}

.bottom-spacer {
  height: 160rpx;
}

/* 底部导航栏 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: rgba(10, 10, 10, 0.9);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  transition: all 0.3s;
}
.nav-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}
.nav-text {
  font-size: 20rpx;
  color: #666;
}
.nav-item.active .nav-text {
  color: #d4af37;
}
.center-btn {
  position: relative;
  top: -30rpx;
}
.center-circle {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #d4af37, #aa8a2e);
  color: #000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 32rpx;
  box-shadow: 0 10rpx 20rpx rgba(212, 175, 55, 0.4);
  border: 6rpx solid #0a0a0a;
}