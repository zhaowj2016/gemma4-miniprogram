<view class="container">
  <view class="header">
    <text class="header-title">{{restaurantName}}</text>
    <view class="header-meta">
      <text class="header-rating">★ {{ratingText}}</text>
      <text class="header-divider">·</text>
      <text class="header-meta-item">月售 {{monthlySalesText}}</text>
      <text class="header-divider">·</text>
      <text class="header-meta-item">人均 ¥{{avgPriceText}}</text>
    </view>
  </view>

  <view class="body">
    <scroll-view class="category-bar" scroll-y="{{true}}">
      <view class="category-item {{currentCategory === item.key ? 'category-item-active' : ''}}" wx:for="{{categories}}" wx:key="key" data-key="{{item.key}}" bindtap="onCategoryTap">
        <text class="category-text">{{item.name}}</text>
      </view>
    </scroll-view>

    <scroll-view class="menu-pane" scroll-y="{{true}}">
      <view class="menu-banner">
        <text class="menu-banner-text">{{currentCategoryBanner}}</text>
      </view>
      <view class="dish-list">
        <view class="dish-item" wx:for="{{dishes}}" wx:key="id">
          <view class="dish-cover">
            <text class="dish-cover-text">{{item.coverText}}</text>
          </view>
          <view class="dish-body">
            <text class="dish-name">{{item.name}}</text>
            <text class="dish-desc">{{item.descText}}</text>
            <view class="dish-tag-row">
              <text class="dish-tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
            </view>
            <view class="dish-bottom-row">
              <view class="dish-price-block">
                <text class="dish-price-currency">¥</text>
                <text class="dish-price">{{item.priceText}}</text>
                <text class="dish-price-original" wx:if="{{item.originalText}}">¥{{item.originalText}}</text>
              </view>
              <view class="dish-cart {{item.qty > 0 ? 'dish-cart-active' : ''}}">
                <view class="cart-minus {{item.qty > 0 ? 'cart-minus-show' : ''}}" data-id="{{item.id}}" bindtap="onMinusTap">
                  <text class="cart-minus-text">-</text>
                </view>
                <text class="cart-qty {{item.qty > 0 ? 'cart-qty-show' : ''}}">{{item.qtyText}}</text>
                <view class="cart-plus" data-id="{{item.id}}" bindtap="onPlusTap">
                  <text class="cart-plus-text">+</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="footer">
    <view class="footer-cart" bindtap="onCartTap">
      <text class="footer-cart-icon">🛒</text>
      <text class="footer-cart-text">{{totalQtyText}} 件 · ¥{{totalAmountText}}</text>
    </view>
    <view class="footer-checkout" bindtap="onCheckoutTap">
      <text class="footer-checkout-text">去结算</text>
    </view>
  </view>
</view>
