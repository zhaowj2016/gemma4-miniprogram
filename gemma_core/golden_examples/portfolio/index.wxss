.container {
  padding-bottom: 180rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

/* 头部 */
.hero {
  padding: 48rpx 32rpx 32rpx;
  background: linear-gradient(160deg, #1a1a2e, #4a3866);
  color: #ffffff;
}
.hero-eyebrow {
  display: block;
  font-size: 24rpx;
  opacity: 0.7;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}
.hero-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.hero-tagline {
  display: block;
  font-size: 26rpx;
  opacity: 0.85;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.hero-stat-row {
  display: flex;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx 0;
}
.hero-stat {
  flex: 1;
  text-align: center;
}
.hero-stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}
.hero-stat-label {
  font-size: 22rpx;
  opacity: 0.8;
}

/* 分类 tab */
.tab-bar {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eeeeee;
  overflow-x: scroll;
}
.tab {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #555555;
  background-color: #f5f6f8;
  border-radius: 30rpx;
}
.tab-active {
  background-color: #1a1a2e;
  color: #ffffff;
}
.tab-text {
  font-size: 26rpx;
}

/* 作品网格 */
.work-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 8rpx;
}
.work-card {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}
.work-card-tall {
  width: 100%;
}
.work-cover {
  width: 100%;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.work-card-tall .work-cover {
  height: 480rpx;
}
.work-cover-text {
  color: #ffffff;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}
.work-body {
  padding: 20rpx;
}
.work-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}
.work-sub {
  display: block;
  font-size: 22rpx;
  color: #888888;
}

/* 流程 */
.section {
  margin: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
}
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}
.process-list {
  display: flex;
  flex-direction: column;
}
.process-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.process-row:last-child {
  border-bottom: none;
}
.process-index {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background-color: #1a1a2e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.process-body {
  flex: 1;
}
.process-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 4rpx;
}
.process-desc {
  display: block;
  font-size: 24rpx;
  color: #888888;
  line-height: 1.6;
}

/* 底部吸边 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}
.footer-msg {
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #f5f6f8;
  border-radius: 40rpx;
  margin-right: 20rpx;
}
.footer-msg-text {
  font-size: 28rpx;
  color: #1a1a1a;
}
.footer-hire {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #1a1a2e;
  border-radius: 40rpx;
}
.footer-hire-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}
