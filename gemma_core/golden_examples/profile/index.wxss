.container {
  padding-bottom: 40rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

/* 用户卡 */
.user-card {
  margin: 0 0 24rpx;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(160deg, #1a2b5e, #3a6df0);
  color: #ffffff;
}
.user-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffb86c, #ff7a59);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}
.avatar-text {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 600;
}
.user-info {
  flex: 1;
}
.user-name {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.user-id {
  display: block;
  font-size: 22rpx;
  opacity: 0.7;
  margin-bottom: 12rpx;
}
.user-level {
  display: inline-block;
  font-size: 22rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.edit-btn {
  width: 96rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
}
.edit-btn-text {
  font-size: 24rpx;
  color: #ffffff;
}

.stat-row {
  display: flex;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx 0;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}
.stat-label {
  font-size: 22rpx;
  opacity: 0.85;
}

/* 订单入口 */
.order-entry {
  margin: 0 24rpx 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
}
.order-entry-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.order-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.order-entry-more {
  font-size: 24rpx;
  color: #999999;
}
.order-entry-grid {
  display: flex;
}
.order-entry-item {
  flex: 1;
  text-align: center;
  position: relative;
}
.order-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #eef3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10rpx;
}
.order-entry-icon-text {
  font-size: 32rpx;
  color: #3a6df0;
}
.order-entry-label {
  display: block;
  font-size: 22rpx;
  color: #555555;
}
.order-entry-badge {
  position: absolute;
  top: -6rpx;
  right: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #ffffff;
  background-color: #e31d1a;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* 菜单列表 */
.menu-section {
  margin: 0 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-row:last-child {
  border-bottom: none;
}
.menu-row-left {
  display: flex;
  align-items: center;
}
.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background-color: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.menu-icon-text {
  font-size: 28rpx;
  color: #3a6df0;
}
.menu-name {
  font-size: 28rpx;
  color: #1a1a1a;
}
.menu-row-right {
  display: flex;
  align-items: center;
}
.menu-extra {
  font-size: 24rpx;
  color: #999999;
  margin-right: 12rpx;
}
.menu-arrow {
  font-size: 28rpx;
  color: #cccccc;
}
