.container {
  padding-bottom: 180rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

/* 顶部 */
.hero {
  padding: 56rpx 32rpx 40rpx;
  background: linear-gradient(160deg, #1a2b5e 0%, #3a6df0 100%);
  color: #ffffff;
}
.hero-eyebrow {
  display: block;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  opacity: 0.7;
  margin-bottom: 12rpx;
}
.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.hero-sub {
  display: block;
  font-size: 26rpx;
  opacity: 0.85;
  line-height: 1.6;
}

/* 联系方式 2x2 */
.contact-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -40rpx 16rpx 0;
  position: relative;
  z-index: 2;
}
.contact-card {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.contact-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #3a6df0, #6a8dff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.contact-icon-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}
.contact-card-name {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 6rpx;
}
.contact-card-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 4rpx;
}
.contact-card-hint {
  display: block;
  font-size: 22rpx;
  color: #aaaaaa;
}

/* section */
.section {
  margin: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
}
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

/* 营业时间 */
.hours-list {
  display: flex;
  flex-direction: column;
}
.hours-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.hours-row:last-child {
  border-bottom: none;
}
.hours-day {
  font-size: 28rpx;
  color: #1a1a1a;
}
.hours-time {
  font-size: 28rpx;
  color: #555555;
}

/* 表单 */
.form {
  display: flex;
  flex-direction: column;
}
.field {
  margin-bottom: 24rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #555555;
  margin-bottom: 12rpx;
}
.input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* 底部吸边 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #3a6df0;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 44rpx;
}
