.container {
  padding-bottom: 40rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

/* 顶部轮播 */
.banner {
  width: 100%;
  height: 480rpx;
}
.banner-slide {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffb86c, #ff7a59);
}
.banner-text {
  color: #ffffff;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

/* 信息卡 */
.info-card {
  margin: -40rpx 24rpx 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.store-name {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}
.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.meta-rating {
  font-size: 28rpx;
  color: #ff8a00;
  font-weight: 600;
  margin-right: 24rpx;
}
.meta-price {
  font-size: 26rpx;
  color: #555555;
  margin-right: 24rpx;
}
.meta-cat {
  font-size: 24rpx;
  color: #888888;
  padding: 4rpx 14rpx;
  background-color: #f5f6f8;
  border-radius: 6rpx;
}
.address-row {
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}
.address-text {
  display: block;
  font-size: 26rpx;
  color: #555555;
  line-height: 1.5;
}
.action-row {
  display: flex;
}
.action-btn {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.action-btn:last-child {
  margin-right: 0;
}
.action-btn-text {
  font-size: 26rpx;
  color: #3a6df0;
}

/* 通用 section */
.section {
  margin: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
}
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

/* 特色 */
.feature-list {
  display: flex;
  flex-direction: column;
}
.feature-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.feature-dot {
  font-size: 28rpx;
  color: #3a6df0;
  margin-right: 12rpx;
  line-height: 1.6;
}
.feature-text {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.6;
  flex: 1;
}

/* 营业时间 */
.hours-list {
  display: flex;
  flex-direction: column;
}
.hours-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.hours-row:last-child {
  border-bottom: none;
}
.hours-day {
  font-size: 28rpx;
  color: #1a1a1a;
}
.hours-time {
  font-size: 28rpx;
  color: #555555;
}

/* 评价 */
.review-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.review-card:last-child {
  border-bottom: none;
}
.review-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.review-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
}
.review-rating {
  font-size: 24rpx;
  color: #ff8a00;
}
.review-text {
  display: block;
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
  margin-bottom: 10rpx;
}
.review-date {
  display: block;
  font-size: 22rpx;
  color: #aaaaaa;
}
