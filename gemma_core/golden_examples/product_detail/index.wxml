<view class="container">
  <swiper class="banner" indicator-dots="{{true}}" autoplay="{{true}}" interval="3000" current="{{currentIndex}}" bindchange="onSwiperChange">
    <swiper-item wx:for="{{banners}}" wx:key="*this">
      <view class="banner-slide">{{item}}</view>
    </swiper-item>
  </swiper>

  <view class="info">
    <text class="title">{{productName}}</text>
    <view class="price-row">
      <text class="price">¥{{priceText}}</text>
      <text class="price-original">¥{{originalPriceText}}</text>
    </view>

    <view class="tags">
      <text class="tag" wx:for="{{tags}}" wx:key="*this">{{item}}</text>
    </view>

    <text class="section-title">产品亮点</text>
    <text class="desc">{{descriptionText}}</text>
  </view>

  <view class="footer">
    <button class="buy-btn" bindtap="onAddToCart">加入购物车</button>
  </view>
</view>
