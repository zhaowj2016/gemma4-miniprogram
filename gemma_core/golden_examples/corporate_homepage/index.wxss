.container {
  padding-bottom: 40rpx;
  background-color: #ffffff;
}

/* 顶部 Hero */
.hero {
  padding: 80rpx 40rpx 60rpx;
  background: linear-gradient(160deg, #1a2b5e 0%, #3a6df0 100%);
  color: #ffffff;
}
.hero-eyebrow {
  display: block;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  opacity: 0.8;
  margin-bottom: 20rpx;
}
.hero-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 24rpx;
}
.hero-sub {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  opacity: 0.9;
  margin-bottom: 40rpx;
}
.hero-actions {
  display: flex;
}
.hero-btn-primary {
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  margin-right: 20rpx;
}
.hero-btn-text {
  color: #3a6df0;
  font-size: 28rpx;
  font-weight: 600;
}
.hero-btn-secondary {
  background-color: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
}
.hero-btn-text-secondary {
  color: #ffffff;
  font-size: 28rpx;
}

/* 通用 section */
.section {
  padding: 60rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.section-eyebrow {
  display: block;
  font-size: 24rpx;
  color: #3a6df0;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.section-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 32rpx;
}

/* 服务卡片 */
.service-grid {
  display: flex;
  flex-wrap: wrap;
}
.service-card {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 32rpx 24rpx;
  background-color: #f7f8fa;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.service-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #3a6df0, #6a8dff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.service-icon-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}
.service-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}
.service-desc {
  display: block;
  font-size: 24rpx;
  color: #777777;
  line-height: 1.6;
}

/* 关于 */
.about-text {
  display: block;
  font-size: 28rpx;
  color: #555555;
  line-height: 1.8;
  margin-bottom: 32rpx;
}
.stat-row {
  display: flex;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #3a6df0;
  margin-bottom: 8rpx;
}
.stat-label {
  font-size: 24rpx;
  color: #888888;
}

/* 客户列表 */
.client-list {
  display: flex;
  flex-wrap: wrap;
}
.client-item {
  width: calc(33.333% - 16rpx);
  margin: 8rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.client-text {
  font-size: 26rpx;
  color: #555555;
}

/* CTA */
.cta {
  margin: 40rpx 24rpx;
  padding: 60rpx 40rpx;
  background: linear-gradient(135deg, #1a2b5e, #3a6df0);
  border-radius: 20rpx;
  text-align: center;
  color: #ffffff;
}
.cta-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.cta-sub {
  display: block;
  font-size: 26rpx;
  opacity: 0.85;
  margin-bottom: 32rpx;
}
.cta-btn {
  display: inline-block;
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
}
.cta-btn-text {
  color: #3a6df0;
  font-size: 28rpx;
  font-weight: 600;
}
