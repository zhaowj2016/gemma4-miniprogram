.container {
  padding-bottom: 180rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

/* 顶部 */
.hero {
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(160deg, #4a3866, #1a1a2e);
  color: #ffffff;
}
.hero-eyebrow {
  display: block;
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 12rpx;
}
.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 20rpx;
}
.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}
.hero-tag {
  font-size: 22rpx;
  background-color: rgba(255, 255, 255, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
.hero-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  opacity: 0.85;
}
.hero-meta-item {
  margin-right: 8rpx;
}
.hero-meta-divider {
  margin: 0 12rpx;
  opacity: 0.5;
}

/* 关键信息 */
.info-card {
  margin: -24rpx 24rpx 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: #777777;
}
.info-value {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}
.salary {
  color: #e31d1a;
  font-weight: 700;
}

/* section */
.section {
  margin: 0 24rpx 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
}
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

/* 职责/要求列表 */
.duty-list {
  display: flex;
  flex-direction: column;
}
.duty-item {
  display: block;
  font-size: 28rpx;
  color: #555555;
  line-height: 1.7;
  margin-bottom: 10rpx;
  position: relative;
  padding-left: 24rpx;
}
.duty-item::before {
  content: '·';
  position: absolute;
  left: 4rpx;
  color: #3a6df0;
  font-weight: 700;
}

/* 福利 */
.benefit-grid {
  display: flex;
  flex-wrap: wrap;
}
.benefit-item {
  width: calc(50% - 12rpx);
  margin: 6rpx;
  padding: 20rpx 16rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.benefit-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #3a6df0, #6a8dff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.benefit-icon-text {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}
.benefit-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 4rpx;
}
.benefit-desc {
  display: block;
  font-size: 22rpx;
  color: #888888;
  line-height: 1.5;
}

/* 团队 */
.team-text {
  display: block;
  font-size: 28rpx;
  color: #555555;
  line-height: 1.8;
}

/* 底部吸边 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}
.footer-chat {
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #f5f6f8;
  border-radius: 40rpx;
  margin-right: 20rpx;
}
.footer-chat-text {
  font-size: 28rpx;
  color: #1a1a1a;
}
.footer-apply {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #3a6df0;
  border-radius: 40rpx;
}
.footer-apply-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}
