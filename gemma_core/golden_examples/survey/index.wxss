.container {
  padding-bottom: 180rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

/* 头部 */
.header {
  padding: 32rpx 32rpx 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}
.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.header-sub {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 20rpx;
}
.progress-bar {
  width: 100%;
  height: 8rpx;
  background-color: #eef0f4;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.progress-fill {
  height: 100%;
  background-color: #3a6df0;
  border-radius: 4rpx;
}
.progress-text {
  display: block;
  font-size: 22rpx;
  color: #888888;
}

/* 题目卡 */
.question-card {
  margin: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
}
.question-label {
  display: block;
  font-size: 22rpx;
  color: #3a6df0;
  margin-bottom: 12rpx;
}
.question-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.question-required {
  display: inline-block;
  font-size: 22rpx;
  color: #e31d1a;
  margin-bottom: 20rpx;
}

.options {
  display: flex;
  flex-direction: column;
}
.option {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #f7f8fa;
}
.option-active {
  background-color: #eef3ff;
  border-color: #3a6df0;
}

/* 单选 */
.option-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #cccccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.option-radio-inner {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background-color: transparent;
}
.option-radio-inner-active {
  background-color: #3a6df0;
}
.option-active .option-radio {
  border-color: #3a6df0;
}

/* 多选 */
.option-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  border: 2rpx solid #cccccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.option-check-text {
  font-size: 28rpx;
  color: transparent;
  font-weight: 700;
}
.option-check-text-active {
  color: #ffffff;
}
.option-active .option-check {
  background-color: #3a6df0;
  border-color: #3a6df0;
}

.option-text {
  font-size: 28rpx;
  color: #1a1a1a;
  flex: 1;
}

/* 文本输入 */
.question-textarea {
  width: 100%;
  height: 240rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
}

/* 底部 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}
.footer-prev {
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #f5f6f8;
  border-radius: 40rpx;
  margin-right: 20rpx;
}
.footer-prev-text {
  font-size: 28rpx;
  color: #555555;
}
.footer-next {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #3a6df0;
  border-radius: 40rpx;
}
.footer-next-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}
