/* 全局基础样式 */
page {
  background-color: #f8f9fb;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #333;
}

.container {
  padding-bottom: 220rpx;
}

/* 顶部品牌与搜索 */
.header-section {
  background-color: #ffffff;
  padding: 60rpx 32rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}
.brand-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}
.brand-info {
  display: flex;
  flex-direction: column;
}
.brand-name {
  font-size: 48rpx;
  font-weight: 900;
  color: #1a2b4c;
  letter-spacing: 6rpx;
  margin-bottom: 8rpx;
}
.brand-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.brand-slogan {
  font-size: 24rpx;
  color: #888;
  letter-spacing: 2rpx;
}
.brand-location {
  font-size: 20rpx;
  color: #c5a059;
  font-weight: 500;
}
.header-actions {
  display: flex;
  gap: 24rpx;
}
.action-icon {
  width: 70rpx;
  height: 70rpx;
  background: #f0f2f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  transition: all 0.2s;
}
.action-icon:active {
  background: #e0e2e5;
  transform: scale(0.9);
}

.search-bar {
  display: flex;
  align-items: center;
  background: #f5f6f8;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  height: 88rpx;
  border: 1rpx solid #eee;
}
.search-icon-emoji {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.search-btn {
  padding: 0 30rpx;
  font-size: 24rpx;
  color: #c5a059;
  font-weight: 600;
}

/* 统计数据网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 32rpx;
  background: #fff;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  border-radius: 24rpx;
  background: #fcfcfc;
  border: 1rpx solid #f0f0f0;
}
.stat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}
.stat-value {
  font-size: 28rpx;
  font-weight: 800;
  color: #1a2b4c;
}
.stat-label {
  font-size: 20rpx;
  color: #999;
}

/* 轮播图 */
.main-swiper {
  height: 480rpx;
  width: 100%;
}
.swiper-item-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.swiper-image {
  width: 100%;
  height: 100%;
}
.swiper-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 70%;
  background: linear-gradient(to top, rgba(26, 43, 76, 0.9), transparent);
}
.swiper-content {
  position: absolute;
  bottom: 60rpx;
  left: 40rpx;
  color: #ffffff;
  z-index: 2;
}
.swiper-tag {
  display: inline-block;
  background: #c5a059;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
}
.swiper-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}
.swiper-subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
}
.swiper-offer {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.offer-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  text-decoration: underline;
}
.offer-date {
  font-size: 22rpx;
  opacity: 0.7;
}

/* 通用 Section */
.section {
  padding: 48rpx 32rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.section-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a2b4c;
  position: relative;
  padding-left: 20rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10%;
  height: 80%;
  width: 8rpx;
  background: #c5a059;
  border-radius: 4rpx;
}
.section-link {
  font-size: 24rpx;
  color: #c5a059;
  font-weight: 500;
}

/* 类目网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx;
}
.category-item {
  width: calc(33.33% - 16rpx);
  padding: 32rpx 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.04);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1rpx solid #f0f0f0;
}
.category-item:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.category-active {
  background: #1a2b4c;
  color: #ffffff;
  border-color: #1a2b4c;
  transform: translateY(-4rpx);
}
.category-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}
.category-name {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.category-desc {
  font-size: 20rpx;
  color: #999;
  text-align: center;
  line-height: 1.4;
}
.category-active .category-desc {
  color: rgba(255,255,255,0.7);
}

/* 服务卡片 */
.service-list {
  height: auto;
}
.service-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.06);
  transition: all 0.3s ease;
  border: 1rpx solid #f0f0f0;
}
.service-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.04);
}
.card-image-box {
  position: relative;
  height: 260rpx;
  width: 100%;
}
.card-image {
  width: 100%;
  height: 100%;
}
.card-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: #c5a059;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.card-expert-tag {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
}
.favorite-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
.fav-icon {
  font-size: 32rpx;
}

.card-body {
  padding: 32rpx;
}
.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.title-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.card-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1a2b4c;
}
.rating-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.star {
  font-size: 20rpx;
}
.rating-val {
  font-size: 22rpx;
  font-weight: 700;
  color: #fbc02d;
}
.sales-val {
  font-size: 20rpx;
  color: #999;
}
.card-price {
  font-size: 38rpx;
  font-weight: 900;
  color: #c5a059;
}
.card-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #eee;
  padding-top: 24rpx;
}
.footer-meta {
  display: flex;
  gap: 30rpx;
}
.meta-item {
  display: flex;
  flex-direction: column;
}
.meta-label {
  font-size: 20rpx;
  color: #bbb;
  margin-bottom: 4rpx;
}
.meta-value {
  font-size: 24rpx;
  color: #444;
  font-weight: 500;
}
.book-btn {
  background: #1a2b4c;
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s;
}
.book-btn:active {
  background: #2c4a8a;
  transform: scale(0.95);
}

/* 推荐套餐 */
.recommendation-section {
  background: #f0f2f5;
}
.rec-scroll {
  white-space: nowrap;
  display: flex;
  gap: 24rpx;
}
.rec-card {
  display: inline-block;
  width: 320rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  vertical-align: top;
  position: relative;
}
.rec-image {
  width: 320rpx;
  height: 200rpx;
}
.rec-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.rec-content {
  padding: 24rpx;
}
.rec-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2b4c;
  margin-bottom: 8rpx;
}
.rec-items {
  display: block;
  font-size: 22rpx;
  color: #777;
  margin-bottom: 16rpx;
  height: 64rpx;
  overflow: hidden;
}
.rec-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.rec-price {
  font-size: 34rpx;
  font-weight: 800;
  color: #c5a059;
}
.rec-original {
  font-size: 22rpx;
  color: #bbb;
  text-decoration: line-through;
}
.rec-btn {
  width: 100%;
  text-align: center;
  background: #f0f2f5;
  color: #1a2b4c;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid #ddd;
}

/* 会员区域 */
.member-section {
  background-color: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  margin-top: 40rpx;
}
.member-scroll {
  white-space: nowrap;
  padding: 32rpx 0;
}
.member-item {
  display: inline-flex;
  align-items: center;
  background: #f8f9fb;
  padding: 20rpx 32rpx;
  border-radius: 100rpx;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
  border: 1rpx solid #eee;
}
.member-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #c5a059;
}
.member-info {
  display: flex;
  flex-direction: column;
}
.member-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.member-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
}
.member-city {
  font-size: 20rpx;
  color: #999;
}
.member-level {
  font-size: 20rpx;
  color: #c5a059;
  font-weight: 600;
}
.member-points {
  font-size: 18rpx;
  color: #bbb;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 40rpx rgba(0,0,0,0.08);
  z-index: 100;
}
.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
}
.nav-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
  transition: transform 0.2s;
}
.nav-item:active .nav-icon {
  transform: scale(1.2);
}
.nav-text {
  font-size: 22rpx;
  color: #666;
}
.cart-badge {
  position: absolute;
  top: -10rpx;
  right: 10rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 18rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(255,77,79,0.4);
}
.main-cta-btn {
  height: 96rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, #1a2b4c 0%, #2c4a8a 100%);
  color: #ffffff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 24rpx rgba(26, 43, 76, 0.4);
  transition: all 0.3s;
  z-index: 101;
}
.main-cta-btn:active {
  transform: scale(0.95);
  box-shadow: 0 6rpx 12rpx rgba(26, 43, 76, 0.2);
}
