.sticky-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx 30rpx;
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  box-shadow: 0 -8rpx 28rpx rgba(15, 23, 42, 0.08);
}
.sticky-bottom-bar__text {
  flex: 1;
  padding-right: 20rpx;
}
.sticky-bottom-bar__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #172033;
}
.sticky-bottom-bar__desc {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
.sticky-bottom-bar__button {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 40rpx;
  background: #1f6feb;
  color: #ffffff;
  font-size: 28rpx;
}
