.store-info {
  margin: 0 24rpx 28rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #102033;
  color: #ffffff;
}
.store-info__name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}
.store-info__desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.82;
  margin-top: 12rpx;
}
.store-info__row {
  display: flex;
  justify-content: space-between;
  padding-top: 18rpx;
  margin-top: 18rpx;
  border-top: 1rpx solid rgba(255,255,255,0.16);
}
.store-info__label {
  font-size: 24rpx;
  opacity: 0.72;
}
.store-info__value {
  font-size: 24rpx;
  text-align: right;
}
